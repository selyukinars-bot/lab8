
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мастер заполнения заявки</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">
    <h1>Заполнение заявки</h1>
    <p class="subtitle">Заполните все три шага</p>

    <div class="progress">
        <div id="progressBar"></div>
    </div>

    <p id="stepTitle">Шаг 1 из 3: Личные данные</p>

    <form id="applicationForm">

        <!-- Шаг 1 -->
        <section class="step" id="step1">
            <h2>Личные данные</h2>

            <label>ФИО:</label>
            <input type="text" id="fullName"
                   placeholder="Введите ваше ФИО" required>

            <label>Электронная почта:</label>
            <input type="email" id="email"
                   placeholder="example@mail.com" required>

            <label>Номер телефона:</label>
            <input type="tel" id="phone"
                   placeholder="+7 777 123 4567" required>
        </section>

        <!-- Шаг 2 -->
        <section class="step" id="step2" hidden>
            <h2>Информация о заявке</h2>

            <label>Категория:</label>
            <select id="category" required>
                <option value="">Выберите категорию</option>
                <option value="Обучение">Обучение</option>
                <option value="Техническая помощь">Техническая помощь</option>
                <option value="Консультация">Консультация</option>
                <option value="Другое">Другое</option>
            </select>

            <label>Тема заявки:</label>
            <input type="text" id="subject"
                   placeholder="Введите тему" required>

            <label>Описание:</label>
            <textarea id="description"
                      placeholder="Опишите вашу заявку"
                      rows="5" required></textarea>
        </section>

        <!-- Шаг 3 -->
        <section class="step" id="step3" hidden>
            <h2>Проверка заявки</h2>
            <p>Проверьте введённые данные перед отправкой.</p>

            <div id="summary"></div>
        </section>

        <div class="buttons">
            <button type="button" id="backBtn" hidden>
                Назад
            </button>

            <button type="button" id="nextBtn">
                Далее
            </button>

            <button type="button" id="submitBtn" hidden>
                Отправить заявку
            </button>
        </div>
    </form>

    <p id="message"></p>

    <h2>Отправленные заявки</h2>
    <div id="applicationsList"></div>

</div>

<script src="script.js"></script>
</body>
</html>
----------------------------

body {
    font-family: Arial, sans-serif;
    background: #eef2f7;
    margin: 0;
    padding: 40px 15px;
}

.container {
    max-width: 550px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 14px;
    box-shadow: 0 5px 20px #0002;
}

h1, h2 {
    text-align: center;
    color: #263445;
}

.subtitle {
    text-align: center;
    color: #777;
}

#stepTitle {
    text-align: center;
    font-weight: bold;
    color: #2878d0;
}

.progress {
    height: 9px;
    background: #ddd;
    border-radius: 10px;
    overflow: hidden;
}

#progressBar {
    width: 33.33%;
    height: 100%;
    background: #2878d0;
    transition: width 0.3s;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 7px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 7px;
    box-sizing: border-box;
    font-size: 15px;
}

textarea {
    resize: vertical;
}

.buttons {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 25px;
}

button {
    padding: 12px 18px;
    border: none;
    border-radius: 7px;
    background: #2878d0;
    color: white;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #155ca8;
}

#backBtn {
    background: #777;
}

#submitBtn {
    background: #16834a;
}

#message {
    text-align: center;
    color: #16834a;
    font-weight: bold;
    margin-top: 20px;
}

.application {
    background: #f1f5fa;
    padding: 12px;
    margin-top: 10px;
    border-radius: 7px;
    overflow-wrap: anywhere;
}

@media (max-width: 500px) {
    .container {
        padding: 18px;
    }

    button {
        padding: 10px;
    }
}
