const form = document.getElementById("applicationForm");

const steps = [
    document.getElementById("step1"),
    document.getElementById("step2"),
    document.getElementById("step3")
];

const nextBtn = document.getElementById("nextBtn");
const backBtn = document.getElementById("backBtn");
const submitBtn = document.getElementById("submitBtn");

const progressBar = document.getElementById("progressBar");
const stepTitle = document.getElementById("stepTitle");
const summary = document.getElementById("summary");
const message = document.getElementById("message");
const applicationsList = document.getElementById("applicationsList");

let currentStep = 0;

// Получаем все поля формы
const fields = [
    "fullName",
    "email",
    "phone",
    "category",
    "subject",
    "description"
];

// Загружаем черновик из sessionStorage
const draft = JSON.parse(
    sessionStorage.getItem("draft")
) || {};

// Восстанавливаем введённые данные
fields.forEach(id => {
    const element = document.getElementById(id);

    if (draft[id] !== undefined) {
        element.value = draft[id];
    }

    // Сохраняем изменения в черновик
    element.addEventListener("input", saveDraft);
    element.addEventListener("change", saveDraft);
});

// Сохранение черновика
function saveDraft() {
    const data = {};

    fields.forEach(id => {
        data[id] = document.getElementById(id).value;
    });

    sessionStorage.setItem("draft", JSON.stringify(data));
}

// Получение данных формы
function getFormData() {
    const data = {};

    fields.forEach(id => {
        data[id] = document.getElementById(id).value.trim();
    });

    return data;
}

// Проверка текущего шага
function validateStep() {
    const inputs = steps[currentStep].querySelectorAll(
        "input, select, textarea"
    );

    for (const input of inputs) {
        if (!input.checkValidity()) {
            input.reportValidity();
            return false;
        }
    }

    return true;
}

// Отображение нужного шага
function showStep() {
    steps.forEach((step, index) => {
        step.hidden = index !== currentStep;
    });

    backBtn.hidden = currentStep === 0;
    nextBtn.hidden = currentStep === 2;
    submitBtn.hidden = currentStep !== 2;

    progressBar.style.width =
        ((currentStep + 1) / 3 * 100) + "%";

    stepTitle.textContent =
        `Шаг ${currentStep + 1} из 3`;

    if (currentStep === 0) {
        stepTitle.textContent += ": Личные данные";
    } else if (currentStep === 1) {
        stepTitle.textContent += ": Информация о заявке";
    } else {
        stepTitle.textContent += ": Проверка и отправка";
        showSummary();
    }
}

// Переход вперёд
nextBtn.addEventListener("click", () => {
    if (!validateStep()) return;

    saveDraft();

    currentStep++;
    showStep();
});

// Переход назад
backBtn.addEventListener("click", () => {
    currentStep--;
    showStep();
});

// Формирование итоговой информации
function showSummary() {
    const data = getFormData();

    const labels = {
        fullName: "ФИО",
        email: "Электронная почта",
        phone: "Телефон",
        category: "Категория",
        subject: "Тема заявки",
        description: "Описание"
    };

    summary.innerHTML = "";

    fields.forEach(id => {
        const paragraph = document.createElement("p");
        const strong = document.createElement("strong");

        strong.textContent = labels[id] + ": ";
        paragraph.append(strong, document.createTextNode(data[id]));

        summary.append(paragraph);
    });
}

// Получаем ранее отправленные заявки
function getApplications() {
    return JSON.parse(
        localStorage.getItem("applications")
    ) || [];
}

// Отображаем отправленные заявки
function renderApplications() {
    applicationsList.innerHTML = "";

    const applications = getApplications();

    applications.forEach((application, index) => {
        const card = document.createElement("div");
        card.className = "application";

        const title = document.createElement("strong");
        title.textContent = `${index + 1}. ${application.subject}`;

        const info = document.createElement("p");
        info.textContent =
            `Заявитель: ${application.fullName} | ` +
            `Категория: ${application.category}`;

        const date = document.createElement("small");
        date.textContent = "Отправлено: " + application.date;

        card.append(title, info, date);
        applicationsList.append(card);
    });

    if (applications.length === 0) {
        applicationsList.textContent = "Пока нет отправленных заявок.";
    }
}

// Отправка окончательной заявки
submitBtn.addEventListener("click", () => {
    const data = getFormData();

    // Сохраняем окончательную заявку
    const applications = getApplications();

    applications.push({
        ...data,
        date: new Date().toLocaleString("ru-RU")
    });

    localStorage.setItem(
        "applications",
        JSON.stringify(applications)
    );

    // Удаляем временный черновик
    sessionStorage.removeItem("draft");

    // Очищаем форму
    form.reset();

    currentStep = 0;
    showStep();

    message.textContent = "Заявка успешно отправлена!";

    renderApplications();
});

// Начальная загрузка
showStep();
renderApplications();
